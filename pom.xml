<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.gwtbootstrap5</groupId>
        <artifactId>gwtbootstrap5-parent</artifactId>
        <version>0.3.2-SNAPSHOT</version>
    </parent>

    <artifactId>gwtbootstrap5</artifactId>
    <name>GwtBootstrap5</name>
    <description>GWT wrapper for the Bootstrap front-end framework</description>
    <url>https://github.com/gwtbootstrap5/gwtbootstrap5</url>
    <packaging>gwt-lib</packaging>

    <scm>
        <connection>scm:git:git@github.com:gwtbootstrap5/gwtbootstrap5.git</connection>
        <developerConnection>scm:git:git@github.com:gwtbootstrap5/gwtbootstrap5.git</developerConnection>
        <url>https://github.com/gwtbootstrap5/gwtbootstrap5</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <junit.version>4.13.2</junit.version>
        <!-- GWT tests (GwtTestSuite) are slow and run only with -P test; plain JVM tests always run -->
        <skipGwtTests>true</skipGwtTests>
        <!--
            Packages whose public API is fully documented: CI checks them with -P javadoc-check, so
            they can't get gaps again. A package joins the list in the commit that documents it.
        -->
        <javadoc.documented.packages>org.gwtbootstrap5.client.ui,org.gwtbootstrap5.client.ui.base,org.gwtbootstrap5.client.ui.base.button,org.gwtbootstrap5.client.ui.base.form,org.gwtbootstrap5.client.ui.base.helper,org.gwtbootstrap5.client.ui.base.mixin,org.gwtbootstrap5.client.ui.base.modal,org.gwtbootstrap5.client.shared.event,org.gwtbootstrap5.client,org.gwtbootstrap5.client.shared.js,org.gwtbootstrap5.client.ui.form.error,org.gwtbootstrap5.client.ui.form.validator,org.gwtbootstrap5.client.ui.gwt,org.gwtbootstrap5.client.ui.html,org.gwtbootstrap5.client.ui.impl,org.gwtbootstrap5.client.ui.util</javadoc.documented.packages>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.gwtproject</groupId>
            <artifactId>gwt-user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.elemental2</groupId>
            <artifactId>elemental2-dom</artifactId>
        </dependency>

        <dependency>
            <groupId>org.gwtproject</groupId>
            <artifactId>gwt-dev</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
            </plugin>
            <plugin>
                <groupId>net.ltgt.gwt.maven</groupId>
                <artifactId>gwt-maven-plugin</artifactId>
                <configuration>
                    <moduleName>org.gwtbootstrap5.gwtbootstrap5</moduleName>
                    <moduleShortName>gwtbootstrap5</moduleShortName>
                    <skipTests>${skipGwtTests}</skipTests>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <!-- gwt-lib binds only gwt:test to the test phase; run the plain JVM tests too -->
                    <execution>
                        <id>jvm-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*Test.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>test</id>
            <properties>
                <skipGwtTests>false</skipGwtTests>
            </properties>
        </profile>
    </profiles>

</project>
